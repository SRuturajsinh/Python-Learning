"""
Pattern Printing in Python

This program demonstrates different star patterns
using both for loops and while loops.
"""
#--------------------------------
# Pattern 1 - Increasing Triangle
#--------------------------------
for i in range(1,6):
        print("*"*i)

i=1
while i<6:
        print("*"*i)
        i+=1
# Output
# *
# **
# ***
# ****
# *****

#--------------------------------
# Pattern 2 - Decreasing Triangle
#--------------------------------
for i in range(5,0,-1):
        print("*"*i)

i=5
while i>0:
     print("*"*i)
     i-=1
# Output
# *****
# ****
# ***
# **
# *


#-----------------------------------
# Pattern 3 - Right-Aligned Triangle
#-----------------------------------
i=5
for j in range(1,6):
    i-=1
    print(" "*i + "*"*j)

i=5
j=1
while j<6:
       i-=1
       print(" "*i + "*"*j)
       j+=1
# Output
#     *
#    **
#   ***
#  **** 
# *****
